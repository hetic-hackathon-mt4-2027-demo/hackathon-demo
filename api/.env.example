# Copié en api/.env à la création du conteneur. Le .env n'est jamais commité.
DATABASE_URL=postgres://app:app@db:5432/app

# IA : n'importe quel fournisseur compatible OpenAI. Décommentez une option.

# 1. Ollama installé sur votre machine
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2:1b
AI_API_KEY=

# 2. Ollama en conteneur (docker compose up -d ollama)
# AI_BASE_URL=http://ollama:11434/v1

# 3. Fournisseur commercial, par exemple Mistral
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_MODEL=mistral-small-latest
# AI_API_KEY=votre-clé